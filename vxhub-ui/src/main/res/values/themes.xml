<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Screens draw their own background edge to edge; the theme only removes the platform chrome. -->
    <style name="VxHub.Screen" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
    </style>
</resources>
